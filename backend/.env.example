# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. Docker compose publishes it on 127.0.0.1:POSTGRES_HOST_PORT in dev
# (change the port if a local Postgres already uses 5432; keep DATABASE_URL in sync).
POSTGRES_HOST_PORT=5432
POSTGRES_USER=partpoint
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=partpoint
DATABASE_URL=postgres://partpoint:change-me-local-only@localhost:5432/partpoint

# Comma-separated origins allowed to call the API from a browser (admin panel)
CORS_ORIGINS=http://localhost:5173

# Caddy site address: ":80" locally, the API hostname in production
SITE_ADDRESS=:80

# Auth secrets: at least 32 chars each, all different. Generate with: openssl rand -base64 48
# The API refuses to start in production while any of these still contains "replace-me".
JWT_SECRET=replace-me-local-jwt-secret-0000000000000000
REFRESH_TOKEN_SECRET=replace-me-local-refresh-secret-000000000000
OTP_SECRET=replace-me-local-otp-secret-0000000000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CONSENT_VERSION=2026-11-01

# Play review demo accounts (comma-separated E.164 phones) and their fixed OTP.
# These numbers never receive an SMS. Leave empty unless demo accounts are needed.
DEMO_PHONES=
DEMO_OTP=

# Messaging. Required in production; in development codes are written to the API log.
SMS_API_KEY=
MAIL_API_KEY=
MAIL_FROM=

# Cloudflare R2 for images. Required in production; without it, image upload URLs return 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Firebase Cloud Messaging: the service-account JSON, raw or base64-encoded.
# Required in production; in development pushes are written to the API log.
FIREBASE_SERVICE_ACCOUNT=
